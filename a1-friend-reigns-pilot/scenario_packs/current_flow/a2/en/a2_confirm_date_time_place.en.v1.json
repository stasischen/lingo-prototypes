      "speaker": "npc",
      "act": "small_change_notice",
      "act_slots": {
        "topic": "small change",
        "keyword": "if",
        "gloss": "如果"
      },
      "learning_role": "listen_only",
      "surface": "If I am late, I will message you.",
      "speak": "If I am late, I will message you.",
      "translation": "如果我晚到，我會傳訊息給你。",
      "friend": {
        "hint": "Your friend is only saying what they will do if they are late. A short reply is enough."
      },
      "reply_set": {
        "correct": "r3a",
        "choices": [
          {
            "id": "r3a",
            "surface": "Okay, I understand.",
            "translation": "好，我知道了。",
            "speak": "Okay, I understand."
          },
          {
            "id": "r3b",
            "surface": "Okay, I am late.",
            "translation": "好，我遲到了。",
            "speak": "Okay, I am late.",
            "contrast_type": "wrong_subject_status",
            "feedback": "Your friend is talking about themselves, not saying you are late."
          },
          {
            "id": "r3c",
            "surface": "If the bus is late, I will call.",
            "translation": "如果公車晚了，我會打電話。",
            "speak": "If the bus is late, I will call.",
            "contrast_type": "wrong_focus_self_delay",
            "feedback": "This changes the focus to your own possible delay. Just acknowledge your friend."
          }
        ]
      }
    },
    {
      "turn_id": "t4",
      "speaker": "npc",
      "act": "final_confirmation",
      "act_slots": {
        "topic": "final check"
      },
      "learning_role": "listen_only",
      "surface": "Great. See you tomorrow.",
      "speak": "Great. See you tomorrow.",
      "translation": "太好了。明天見。",
      "friend": {
        "hint": "The details are clear now. Close naturally."
      },
      "reply_set": {
        "correct": "r4a",
        "choices": [
          {
            "id": "r4a",
            "surface": "Yes, see you tomorrow.",
            "translation": "好，明天見。",
            "speak": "Yes, see you tomorrow."
          },
          {
            "id": "r4b",
            "surface": "Yes, see you yesterday.",
            "translation": "好，昨天見。",
            "speak": "Yes, see you yesterday.",
            "contrast_type": "wrong_time_expression",
            "feedback": "See you yesterday is not natural. Use see you tomorrow."
          },
          {
            "id": "r4c",
            "surface": "Can I have the bill?",
            "translation": "可以給我帳單嗎？",
            "speak": "Can I have the bill?",
            "contrast_type": "wrong_scenario_payment",
            "feedback": "This is a payment sentence. Here you are only closing the plan."
          }
        ]
      }
    }
  ],
  "choice_sets": [
    "t1.reply_set",
