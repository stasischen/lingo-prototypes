  "support_text": "Read your friend's short message. Confirm the date, time, and place.",
  "roles": {
    "npc": {
      "label": "Friend"
    },
    "learner": {
      "label": "You"
    }
  },
  "turns": [
    {
      "turn_id": "t1",
      "speaker": "npc",
      "act": "message_reference",
      "act_slots": {
        "topic": "sent message",
        "keyword": "message",
        "gloss": "訊息"
      },
      "learning_role": "listen_only",
      "surface": "Did you check my message?",
      "speak": "Did you check my message?",
      "translation": "你看過我的訊息了嗎？",
