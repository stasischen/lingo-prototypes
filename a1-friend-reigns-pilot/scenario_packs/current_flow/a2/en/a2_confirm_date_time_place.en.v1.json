      "translation": "對。我們在哪裡見？",
      "friend": {
        "hint": "The place in the message is in front of City Hall."
      },
      "inline_explain": {
        "pattern_id": "en.a2.confirm.place.in_front_of.v1",
        "title": "in front of + place",
        "explain": "Use in front of to say the meeting point is outside and before a place.",
        "items": [
          {
            "surface": "in front of City Hall",
            "translation": "在市政廳前面",
            "speak": "in front of City Hall"
          },
          {
            "surface": "in front of the cafe",
            "translation": "在咖啡店前面",
            "speak": "in front of the cafe"
          }
        ]
      },
      "reply_set": {
        "correct": "r2a",
        "choices": [
          {
            "id": "r2a",
            "surface": "In front of City Hall.",
            "translation": "在市政廳前面。",
            "speak": "In front of City Hall.",
            "learning_role": "production_target"
          },
          {
            "id": "r2b",
            "surface": "Inside City Hall.",
            "translation": "在市政廳裡面。",
            "speak": "Inside City Hall.",
            "contrast_type": "wrong_place_relation",
            "feedback": "The message says in front of City Hall, not inside it."
          },
          {
            "id": "r2c",
            "surface": "I am going to rest at home.",
